PORT=5000
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Allowed browser origin for CORS / sockets (leave empty to allow same-origin only)
CLIENT_ORIGIN=
# Max people per room (mesh video gets heavy above ~5)
MAX_PEERS=6
# Optional TURN server (needed for users behind strict NATs / different networks)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Public URL used in password reset links
APP_URL=http://localhost:5000
# SMTP settings for sending password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
